            }
          // fall through
          case 62: break;
          case 24:
            { return symbol(TOKEN_TYPE.NEQ);
            }
          // fall through
          case 63: break;
          case 25:
            { System.out.print("FLOAT: "); return symbol(TOKEN_TYPE.VAL_FLOAT, Float.parseFloat(yytext()));
