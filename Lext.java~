          // fall through
          case 64: break;
          case 26:
            { return symbol(TOKEN_TYPE.DDDOT);
            }
          // fall through
          case 65: break;
          case 27:
            { return symbol(TOKEN_TYPE.EQEQ);
            }
          // fall through
          case 66: break;
          case 28:
            { return symbol(TOKEN_TYPE.IF);
            }
          // fall through
          case 67: break;
          case 29:
            { yybegin(YYINITIAL);
            }
          // fall through
          case 68: break;
          case 30:
            { return symbol(TOKEN_TYPE.INT);
            }
          // fall through
          case 69: break;
          case 31:
            { return symbol(TOKEN_TYPE.BOOL);
            }
          // fall through
          case 70: break;
          case 32:
            { return symbol(TOKEN_TYPE.CHAR);
            }
          // fall through
          case 71: break;
          case 33:
            { return symbol(TOKEN_TYPE.DATA);
            }
          // fall through
          case 72: break;
          case 34:
            { return symbol(TOKEN_TYPE.ELSE);
            }
          // fall through
          case 73: break;
          case 35:
            { return symbol(TOKEN_TYPE.READ);
            }
          // fall through
          case 74: break;
          case 36:
            { return symbol(TOKEN_TYPE.FLOAT);
            }
          // fall through
          case 75: break;
          case 37:
            { return symbol(TOKEN_TYPE.PRINT);
            }
          // fall through
          case 76: break;
          case 38:
            { return symbol(TOKEN_TYPE.RET);
            }
          // fall through
          case 77: break;
