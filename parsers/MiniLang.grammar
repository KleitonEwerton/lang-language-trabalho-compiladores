%package "parsers";
%import "ast.*";
%import "java.io.IOException";

%class "MiniLangParser";

%terminals TYPE_INT, TYPE_CHAR, TYPE_BOOL, TYPE_FLOAT, TYPE_DATA,
           IF, ELSE, ITERATE, READ, PRINT, RETURN, NULL, TRUE, FALSE,
           ID, NAME, INT, FLOAT, CHAR,
           OPEN_BRACKET, CLOSE_BRACKET, DOT, OPEN_PARENTHESIS, CLOSE_PARENTHESIS, OPEN_BRACE, CLOSE_BRACE,
           NOT, MULT, DIV, MOD, PLUS, MINUS,
           LESS_THAN, GREATER_THAN, EQUAL_EQUAL, NO_EQUAL,
           AND, SEMI, COLON, SRO, COMMA, EQUAL,
           AP, FP, TYPE_NEW;

%left PLUS, MINUS;      
%left MULT, DIV, MOD;   
%left LESS_THAN, GREATER_THAN; 
%left EQUAL_EQUAL, NO_EQUAL;   
%left AND;      
%left COMMA;         

%right EQUAL; 
%right SRO;       
%right NOT;       

%nonassoc IF, ELSE;
%nonassoc RETURN; 
%nonassoc TYPE_INT, TYPE_CHAR, TYPE_BOOL, TYPE_FLOAT, TYPE_DATA; 
%nonassoc NULL, TRUE, FALSE; 
%nonassoc OPEN_BRACKET, CLOSE_BRACKET, DOT, OPEN_PARENTHESIS, CLOSE_PARENTHESIS, OPEN_BRACE, CLOSE_BRACE; 
%nonassoc ITERATE, READ, PRINT;  
%nonassoc SEMI, COLON;  


%nonassoc EQUAL_EQUAL;
%nonassoc LESS_THAN;
%nonassoc GREATER_THAN;



%embed {: private boolean good;
          
          public boolean isGood(){ return good;}
          
          protected void recoverFromError(Symbol token, TokenStream in) throws IOException, Parser.Exception{
              super.recoverFromError(token, in);
              good = false;
          }
:} ;

%init {: good = true; :} ;


// Tipos dos elementos
%typeof ID       = "String";
%typeof NAME     = "String";
%typeof INT      = "Integer";
%typeof FLOAT    = "Float";
%typeof CHAR     = "Character";
%typeof Prog     = "Node";
%typeof Def      = "Node";
%typeof Data     = "Node";
%typeof Decl     = "Node";
%typeof Func      = "Node";
%typeof Params    = "Node";
%typeof Type     = "Node";
%typeof Btype    = "Node";
%typeof Cmd      = "Node";
%typeof Exp      = "Expr";
%typeof Lvalue   = "Node";
%typeof Exps     = "Node";
%typeof AP     = "(";
%typeof FP     = ")";
%typeof TYPE_NEW = "new";


%goal Prog;

Prog = Def.s+                                               {: return new Program(s); :}
     ;  

Def = Data.d                                                {: return d; :}
    | Func.fn                                               {: return fn; :}
    ;

Data = TYPE_DATA NAME.nm OPEN_BRACE Decl.dl* CLOSE_BRACE     {: return new Data(nm, dl); :}
     ;


Decl = ID.v SRO Type.t SEMI                         {: return new Decl(v, t); :}
     ;

Func = ID.v OPEN_PARENTHESIS Params.p? CLOSE_PARENTHESIS AP COLON Type.t AP COMMA Type.t FP* FP? OPEN_BRACE Cmd.c* CLOSE_BRACE {: return new Func(v, p, t, c); :}
     ;

Params = ID.v SRO Type.t AP COMMA ID.v SRO Type.t FP*                  {: return new Params(v, t, v, t); :}
       ;

Type = Type.t OPEN_BRACKET CLOSE_BRACKET                           {: return new ArrayType(t); :} 
     | Btype.b                                                     {: return b; :}
     ;

Btype =  TYPE_INT                                                  {: return new TyInt();    :}
      |  TYPE_CHAR                                                 {: return new TyChar();    :}
      |  TYPE_BOOL                                                 {: return new TyBool();    :}
      |  TYPE_FLOAT                                                {: return new TyFloat();    :}
      |  ID.v                                                      {: return new CustomType(v); :}
      ;

Cmd = OPEN_BRACE Cmd.c* CLOSE_BRACE                                {: return new Block(c); :}
    | IF OPEN_PARENTHESIS Exp.e CLOSE_PARENTHESIS Cmd.c            {: return new If(e, c); :}       
    | IF OPEN_PARENTHESIS Exp.e CLOSE_PARENTHESIS Cmd.c1 ELSE Cmd.c2 {: return new If(e,c1,c2); :}
    | ITERATE OPEN_PARENTHESIS Exp.e CLOSE_PARENTHESIS Cmd.c       {: return new While(e, c); :}
    | READ Lvalue.l SEMI                                           {: return new Read(l); :}
    | PRINT Exp.e SEMI                                             {: return new Print(e); :}
    | RETURN Exp.e AP COMMA Exp FP* SEMI                               {: return new Return(e); :}
    | Lvalue.l EQUAL Exp.e SEMI                                    {: return new Equal(l, e); :}
    | ID OPEN_PARENTHESIS Exps CLOSE_PARENTHESIS AP LESS_THAN Lvalue  AP COMMA Lvalue FP* GREATER_THAN FP? SEMI {: return new Call(fn, e, l); :}
    ;

CExpr = CExpr.e1 AND CExpr.e2                                       {: return new And(e1,e2);  :}
      | Exp.e1 LESS_THAN Exp.e2                                     {: return new Lt(e1,e2);   :}
      | Exp.e1 EQUAL_EQUAL Exp.e2                                   {: return new EqEq(e1,e2);   :}
      | Exp.e1 NO_EQUAL Exp.e2                                      {: return new Neq(e1, e2); :}
      | Exp.e                                                       {: return e; :}
      ; 


Exp = Exp.e1 PLUS Exp.e2                                            {: return new Add(e1, e2); :}
    | Exp.e1 MINUS Exp.e2                                           {: return new Sub(e1, e2); :}
    | Exp.e1 MULT Exp.e2                                            {: return new Mul(e1, e2);  :}
    | Exp.e1 DIV Exp.e2                                             {: return new Div(e1, e2); :}
    | Exp.e1 MOD Exp.e2                                             {: return new Mod(e1, e2); :}
    | NOT CExpr.e                                                   {: return new Not(e);    :}
    | MINUS CExpr.e                                                 {: return new Neg(e); :}
    | INT.n                                                         {: return new NInt(n);   :}
    | FLOAT.f                                                       {: return new NFloat(f); :}
    | CHAR.c                                                        {: return new NChar(c); :}
    | TRUE                                                          {: return new True();    :}
    | FALSE                                                         {: return new False();   :}
    | NULL                                                          {: return new Null(); :}
    | Lvalue.l                                                      {: return l; :}
    | OPEN_PARENTHESIS CExpr.e CLOSE_PARENTHESIS                    {: return e; :}
    | TYPE_NEW Type.t AP OPEN_BRACKET CExpr.e CLOSE_BRACKET FP?     {: return new New(t, e); :}
    | ID.v OPEN_PARENTHESIS Exps.e? CLOSE_PARENTHESIS OPEN_BRACKET CExpr.ce CLOSE_BRACKET {: return new Call(v, e, ce); :}
    ;


Lvalue = ID.v                                                       {: return new Var(v); :}
       | Lvalue.l OPEN_BRACKET Exp.e CLOSE_BRACKET                  {: return new Index(l, e); :}
       | Lvalue.l DOT ID.v                                          {: return new Field(l, v); :}
       ;

Exps = Exp.e AP COMMA Exp.ep FP*                                        {: return new ExpList(e, ep); :}
     ;
