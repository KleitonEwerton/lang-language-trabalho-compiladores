group java;

program(name, funcs, datas) ::= <<
import java.util.Scanner;

public class <name> {
    
    <funcs; separator="\n\n">
    <datas; separator="\n\n">

    public static void main(String args[]) {
        <name> m = new <name>();
        m.main();
    }
}
>>

func(type, name, params, decl, stmt) ::= <<
<type> <name>(<params; separator=", ">) {
    <if(decl)><decl; separator=";\n">;<endif>
    <stmt; separator="\n">
}
>>

data(name, decl) ::= <<
public class <name> {
    <if(decl)><decl; separator="\n"><endif>
};
>>

param(type, name) ::= "<type> <name>"

array_type(type) ::= "<type>[]"
int_type() ::= "Integer"
float_type() ::= "Float"
boolean_type() ::= "Boolean"
char_type() ::= "Character"

data_type(data) ::= "<data>"
null_type() ::= "null"

print(expr) ::= "System.out.print(<expr>);"

read(expr, isInt, isFloat, isChar) ::= <<
<if(isInt)>
<expr> = Integer.parseInt(new Scanner(System.in).nextLine());
<elseif(isFloat)>
<expr> = Float.parseFloat(new Scanner(System.in).nextLine());
<elseif(isChar)>
<expr> = new Scanner(System.in).nextLine().charAt(0);
<else>
<expr> = new Scanner(System.in).nextLine();
<endif>
>>

return(expr) ::= "return <expr>;"

iterate(expr, cmd, loopAtual) ::= <<
int iLoop<loopAtual> = <expr>;
while (iLoop<loopAtual> > 0) {
    <cmd; separator="\n">
    iLoop<loopAtual>--;
}
>>

if(expr, cmd_if) ::= <<
if (<expr>) {
    <if(cmd_if)><cmd_if; separator="\n"><else>//nenhum comando no bloco <endif>
}
>>

if_else(expr, cmd_if, cmd_else) ::= <<
if (<expr>) {
    <if(cmd_if)><cmd_if; separator="\n"><else>// nenhum comando no bloco <endif>
} else {
    <if(cmd_else)><cmd_else; separator="\n"><else>// nenhum comando no bloco <endif>
}
>>

declaration(type, name) ::= "<type> <name>;"    
attr(var, expr) ::= "<var> = <expr>;"

newExp(type, expr) ::= <<
new <type><if(expr)>[<expr>]<else>()<endif>
>>

lvalue(name, array) ::= <<
<name><if(array)><array><endif>
>>

array_access(expr) ::= "[<expr>]"

boolean_expr(value) ::= "<value>"
float_expr(value) ::= "<value>f"
char_expr(value) ::= "<value>"
int_expr(value) ::= "<value>"


functionReturn(name, args, returnExpr) ::= <<
<name><if(returnExpr)>_<returnExpr><else><endif>(<args; separator=", ">)
>>

funcCall(name, args, ret1, ret2) ::= <<
<ret1> = <name>_0(<args; separator=", ">);<if(ret2)><ret2> = <name>_1(<args; separator=", ">);<else><endif>
>>

call(name, args) ::= <<
<name>(<args; separator=", ">);
>>

mul_expr(left_expr, right_expr) ::= "(<left_expr> * <right_expr>)"
div_expr(left_expr, right_expr) ::= "(<left_expr> / <right_expr>)"
mod_expr(left_expr, right_expr) ::= "(<left_expr> % <right_expr>)"
add_expr(left_expr, right_expr) ::= "(<left_expr> + <right_expr>)"
sub_expr(left_expr, right_expr) ::= "(<left_expr> - <right_expr>)"


lt_expr(left_expr, right_expr) ::= "(<left_expr> \< <right_expr>)"
equals_expr(left_expr, right_expr) ::= "(<left_expr> == <right_expr>)"
not_equals_expr(left_expr, right_expr) ::= "(<left_expr> != <right_expr>)"
and_expr(left_expr, right_expr) ::= "(<left_expr> && <right_expr>)"
not_expr(expr) ::= "!<expr>"
neg_expr(expr) ::= "-<expr>"
