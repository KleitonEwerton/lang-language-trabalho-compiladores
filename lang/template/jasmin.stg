group jasmin;

program(name, funcs, datas) ::= <<
.source <name>
.class public <name>
.super java/lang/Object

<datas; separator="\n\n">

<funcs; separator="\n\n">

.method public static main([Ljava/lang/String;)V
    .limit stack 1
    invokestatic <name>/inicio()I
    return
.end method
>>

data(name, fields) ::= <<
.class public <name>
.super java/lang/Object

.field public static final serialVersionUID J

<fields; separator="\n">

.method public <name>()V
    aload_0
    invokespecial java/lang/Object/<init>()V
    return
.end method
>>

field(name, type) ::= <<
.field public <name> <type>
>>

create_data_instance(name) ::= <<
new <name>
dup
invokespecial <name>/<init>()V
>>

data_field_access(name, field) ::= <<
getfield <name>/<field>
>>

func(return, name, params, decls, stack, stmt) ::= <<
.method static <name>(<params>)<return>
    .limit stack <stack>
    .limit locals <decls>
    <stmt>
.end method
>>

array_type(type) ::= "[<type>"
int_type() ::= "I"
float_type() ::= "F"
boolean_type() ::= "Z"

char_expr(value) ::= <<
    ldc #<value>
>>

stmt_list(stmt1, stmt2) ::= <<
<stmt1>
<stmt2>
>>

iprint(expr) ::= <<
getstatic java/lang/System/out Ljava/io/PrintStream;
<expr>
invokevirtual java/io/PrintStream/println(I)V
>>

ireturn(expr) ::= <<
<expr>
ireturn
>>

while(num,expr, stmt) ::= <<
#<num>:
<expr>
ifeq #<num>#end
<stmt>
goto #<num>
#<num>#end:
nop
>>

if(num, expr, thn, els) ::= <<
<expr>
ifeq #<num>
<thn>
goto #<num>#end
#<num>:
<els>
#<num>#end:
nop
>>

iarray(num, expr) ::= <<
<expr>
newarray int
astore <num>
>>

call(class, name, type, return, args) ::= <<
<args; separator="\n">
invokestatic <class>/<name>(<type>)<return>
>>

istore(num, expr) ::= <<
<expr>
istore <num>
>>

iastore(num, index, expr) ::= <<
aload <num>
<index>
<expr>
iastore
>>

iaccess(num) ::= "iload <num>"

iaaccess(num, expr) ::= <<
aload <num>
<expr>
iaload
>>

iaload(num) ::= <<
aload <num>
>>

imul(left_expr, right_expr) ::= <<
<left_expr>
<right_expr>
imul
>>

idiv(left_expr, right_expr) ::= <<
<left_expr>
<right_expr>
idiv
>>

imod(left_expr, right_expr) ::= <<
<left_expr>
<right_expr>
irem
>>

iadd(left_expr, right_expr) ::= <<
<left_expr>
<right_expr>
iadd
>>

isub(left_expr, right_expr) ::= <<
<left_expr>
<right_expr>
isub
>>

ilt_expr(num, left_expr, right_expr) ::= <<
<right_expr>
<left_expr>
isub
ifgt #<num>
iconst_0
goto #<num>#<num>
#<num>:
iconst_1
#<num>#<num>:
>>

iequals_expr(num, left_expr, right_expr) ::= <<
<left_expr>
<right_expr>
isub
ifeq #<num>
iconst_0
goto #<num>#<num>
#<num>:
iconst_1
#<num>#<num>:
>>

not_expr(expr) ::= <<
<expr>
iconst_1
ixor
>>

and_expr(left_expr, right_expr) ::= <<
<left_expr>
<right_expr>
iand
>>

boolean_true() ::= "iconst_1"
boolean_false() ::= "iconst_0"
float_expr(value) ::= "ldc <value>"
int_expr(value) ::= "sipush <value>"